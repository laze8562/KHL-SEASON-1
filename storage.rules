rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Видео голов: смотрят все, загружает и удаляет только создатель (до 100 МБ, только видео)
    match /goals/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'admin@khl-s1.app'
        && (request.method == 'delete'
            || (request.resource.size < 100 * 1024 * 1024
                && request.resource.contentType.matches('video/.*')));
    }
  }
}
